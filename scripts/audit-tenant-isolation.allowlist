# audit-tenant-isolation allow-list
# One regex per line. Lines matching either the relative file path
# (e.g. backend/routes/foo.js) or the file:line locator are skipped.
# Blank lines and lines starting with '#' are ignored.
#
# Pre-populate with: routes that are deliberately tenant-agnostic
# (the matcher should already pass them, but keep this as a safety
# net for the next refactor).
backend/routes/health\.js
backend/routes/sitemap\.js
backend/routes/blog\.js
backend/routes/superadmin\.js
backend/routes/landing\.js
# openapi.js — apiKeyAuth scopes by partner_id (implicitly tenant)
backend/routes/openapi\.js
# publicApi.js — same: apiKeyAuth scopes by partner_id
backend/routes/publicApi\.js
# referralLinks.js:22 — globally unique referral_code lookup (no tenant by design)
backend/routes/referralLinks\.js:22
