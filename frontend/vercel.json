{
  "git": {
    "deploymentEnabled": {
      "dependabot/npm_and_yarn/**": false
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/:path*",
      "destination": "https://skipcall-partners-production.up.railway.app/api/:path*"
    },
    {
      "source": "/r/:path*",
      "has": [{ "type": "query", "key": "ref" }],
      "destination": "https://skipcall-partners-production.up.railway.app/r/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
